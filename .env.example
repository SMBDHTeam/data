SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tour_dev
SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=your-db-password

# Enable ODSAY in local/dev environments when schedule routes should use public transit.
# If disabled, long route failures can fall back to estimated walking routes.
ODSAY_ENABLED=true
ODSAY_API_KEY=your-odsay-api-key
ODSAY_BASE_URL=https://api.odsay.com

# Enable TMAP walking routes only when SKT_API_KEY is configured with a real key.
TMAP_WALKING_ENABLED=true
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_TRANSIT_BASE_URL=https://apis.openapi.sk.com
SKT_API_KEY=your-skt-api-key

TOUR_API_KEY=your-tour-api-key
BUSAN_BUS_API_KEY=your-busan-bims-api-key

SCHEDULE_CANDIDATE_POOL_TTL_SECONDS=60

# Every data instance must use the same high-entropy value. Course previews are
# signed in memory and do not write schedule/place business rows.
SPONTANEOUS_PREVIEW_SECRET=replace-with-at-least-32-random-bytes
SPONTANEOUS_PREVIEW_TTL_SECONDS=1200
